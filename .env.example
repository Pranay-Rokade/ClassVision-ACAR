# ============================================================
# ClassVision-ACAR — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# Django secret key (generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=your-secret-key-here

# Email credentials for OTP verification (Gmail App Password recommended)
EMAIL_ID=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional overrides (defaults are fine for local/Docker)
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=*
